generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  RESTAURANT_ADMIN
  SUPER_ADMIN
}

// Fine-grained permission level within a single restaurant's admin
// accounts (only meaningful when AdminRole = RESTAURANT_ADMIN). Defaults
// to OWNER so every pre-existing AdminUser row needs no backfill.
enum StaffRole {
  OWNER
  EDITOR
  VIEWER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model Restaurant {
  id               String   @id @default(cuid())
  name             Json     // { "tr": "...", "en": "...", "ar": "..." }
  slug             String   @unique
  themeColor       String   @default("#E63946")
  logoUrl          String?
  supportedLocales String[] // e.g. ["tr", "en", "ar"]
  defaultLocale    String   @default("tr")
  createdAt        DateTime @default(now())
  isActive         Boolean  @default(true)
  deletedAt        DateTime?

  categories Category[]
  adminUsers AdminUser[]
  settings   RestaurantSettings?
  locations  Location[]
  tables     Table[]
  menuSessions MenuSession[]
  menuViews  MenuView[]
  pageViews  PageView[]
  orders     Order[]
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         Json     // { "tr": "...", "en": "...", "ar": "..." }
  photoUrl     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  name        Json     // { "tr": "...", "en": "...", "ar": "..." }
  description Json?    // { "tr": "...", "en": "...", "ar": "..." }
  price       Decimal  @db.Decimal(10, 2)
  photoUrl    String?
  options     Json?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  isAvailable Boolean  @default(true)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String   @id @default(cuid())
  restaurantId String?
  email        String   @unique
  passwordHash String
  // Display name for staff accounts (e.g. "Ahmet - Garson").
  name         String?
  createdAt    DateTime @default(now())
  role         AdminRole @default(RESTAURANT_ADMIN)
  // Permission level within the restaurant (OWNER/EDITOR/VIEWER) - see
  // the StaffRole enum above.
  staffRole    StaffRole @default(OWNER)

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model RestaurantSettings {
  id                    String   @id @default(cuid())
  restaurantId          String   @unique
  orderingEnabled       Boolean  @default(false)
  dineInEnabled         Boolean  @default(false)
  takeawayEnabled       Boolean  @default(false)
  estimatedPrepMinutes  Int      @default(15)
  currency              String   @default("TRY")
  timezone              String   @default("Europe/Istanbul")

  // SEO & social sharing (used by the public menu's page metadata)
  metaTitle             String?
  metaDescription       String?
  keywords              String?

  // Feature flags
  enableOrdering        Boolean  @default(true)
  enableTables          Boolean  @default(true)
  enableAnalytics       Boolean  @default(true)
  enableMultiLanguage   Boolean  @default(true)
  enableReviews         Boolean  @default(false)
  enableServiceCall     Boolean  @default(false)

  // RBAC Feature Permissions
  canViewOrders         Boolean  @default(true)
  canTrackTables        Boolean  @default(true)
  canManageMenu         Boolean  @default(true)
  canManageStaff        Boolean  @default(true)
  canViewAnalytics      Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Location {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     Table[]
}

model Table {
  id           String   @id @default(cuid())
  locationId   String
  restaurantId String
  name         String
  isActive     Boolean  @default(true)
  qrIdentifier String?  @unique
  nfcIdentifier String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuSessions MenuSession[]
}

model MenuSession {
  id           String    @id @default(cuid())
  restaurantId String
  tableId      String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  ipHash       String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orders     Order[]
}

model MenuView {
  id           String   @id @default(cuid())
  restaurantId String
  tableId      String?
  ipHash       String?
  userAgent    String?
  recordedAt   DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, recordedAt])
}

model Order {
  id           String      @id @default(cuid())
  restaurantId String
  locationId   String?
  tableId      String?
  sessionId    String?
  status       OrderStatus @default(PENDING)
  totalAmount  Decimal     @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  session    MenuSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  items      OrderItem[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    Json    // snapshot of name at time of order
  productPrice   Decimal @db.Decimal(10, 2) // snapshot of price at time of order
  quantity       Int     @default(1)
  options        Json?
  notes          String?
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PageView {
  id           String   @id @default(cuid())
  restaurantId String
  timestamp    DateTime @default(now())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, timestamp])
}
