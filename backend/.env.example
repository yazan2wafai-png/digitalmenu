# Copy this file to .env and fill in your values
# ---------------------------------------------------
# Option A: Use the provided Docker Compose setup:
#   docker compose up -d
# Then use the URL below as-is.
#
# Option B: Point to your own PostgreSQL instance.
# ---------------------------------------------------

DATABASE_URL="postgresql://digitalmenu:digitalmenu@localhost:5432/digitalmenu"

# JWT Authentication
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Base URL for constructing public file URLs (local storage)
# Change to your deployed domain in production
BASE_URL="http://localhost:3001"
